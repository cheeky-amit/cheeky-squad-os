{
  "name": "cheeky-squad-os",
  "displayName": "cheeky-squad-os",
  "description": "Ship the discipline, not the team. Generate and export bespoke, provider-neutral squads for Claude Code and Codex.",
  "version": "1.1.0",
  "author": {
    "name": "cheeky-amit"
  },
  "license": "MIT",
  "keywords": [
    "squad",
    "subagents",
    "agent-teams",
    "workflow",
    "discipline",
    "claude-code-plugin",
    "codex-plugin",
    "portable-agents",
    "skills",
    "hooks",
    "thought-partner",
    "human-in-the-loop"
  ],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/session-start.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/user-prompt-submit.sh",
            "timeout": 3
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "Bash|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/permission-request.sh",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
